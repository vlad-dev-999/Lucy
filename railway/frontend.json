{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @workspace/hospital-mmf run build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/hospital-mmf run serve",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
